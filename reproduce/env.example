# Copy to /home/ubuntu/venv.env on the cluster master (sourced by every launcher) and export SSH_KEY in your shell.
VENV=/opt/aws_neuronx_venv_pytorch_2_8          # python venv with torch-neuronx / torch-xla / neuronx-distributed
WORKERS="10.0.0.11 10.0.0.12 10.0.0.13 10.0.0.14 10.0.0.15 10.0.0.16"   # worker private IPs (master excluded); 6 for 7 nodes
# export SSH_KEY=$HOME/.ssh/<cluster-key>.pem   # key that reaches every worker as ubuntu@<ip>
# export ANTHROPIC_API_KEY=...                  # LLM proposer (Phase 3); or configure AWS Bedrock credentials (search/_anthropic_route.py)
# Optional launcher knobs read by experiments/cluster_224rank/scripts/run_ap7.sh:
#   WORKERS_OVERRIDE="ip1 ip2 ip3 ip4"   -> 5-node run;  WORKERS_OVERRIDE="ip1 ip2" -> 3-node run;  WORKERS_OVERRIDE=' ' -> single node
#   COLD=1                                -> wipe the Neuron compile cache on every node first (wall-clock / break-even measurement)
#   RESULTS_DIR=...                       -> where the per-run JSON lands (default training/results/7node)
